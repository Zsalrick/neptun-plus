{
  "appId": "hu.neptun.autologin",
  "appName": "Kredit+",
  "webDir": "www",
  "plugins": {
    "CapacitorHttp": { "enabled": true },
    "CapacitorUpdater": { "autoUpdate": false, "directUpdate": false },
    "LocalNotifications": { "smallIcon": "ic_stat_neptun", "iconColor": "#ECEDEE" },
    "BackgroundRunner": { "label": "hu.neptun.autologin.check", "src": "runner.js", "event": "checkNeptun", "repeat": true, "interval": 30, "autoStart": true }
  },
  "cordova": {
    "preferences": {
      "OverrideUserAgent": "Mozilla/5.0 (Linux; Android 14; Pixel 7) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Mobile Safari/537.36"
    }
  }
}
