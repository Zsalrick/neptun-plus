<?xml version="1.0" encoding="utf-8"?>
<!-- Óra / számonkérés widget: balra nagy szám (kezdés vagy napok), jobbra nagy cím. Egy pillantásra olvasható. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:paddingLeft="20dp"
    android:paddingRight="18dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/w_timecol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="84dp"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/w_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:fontFeatureSettings="tnum"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:text="08:00" />

        <TextView
            android:id="@+id/w_bigsub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:includeFontPadding="false"
            android:fontFeatureSettings="tnum"
            android:textColor="#8E939B"
            android:textSize="14sp"
            android:maxLines="1"
            android:text="09:30" />
    </LinearLayout>

    <View
        android:id="@+id/w_div"
        android:layout_width="1dp"
        android:layout_height="46dp"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="16dp"
        android:background="#26FFFFFF"
        android:visibility="visible" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="#F5B221"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Most tart" />

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="15sp"
            android:autoSizeMaxTextSize="21sp"
            android:autoSizeStepGranularity="1sp"
            android:text="Statisztika" />

        <TextView
            android:id="@+id/w_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:textColor="#B4B8C0"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Előadás · B.101" />
    </LinearLayout>
</LinearLayout>
