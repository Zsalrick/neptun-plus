<?xml version="1.0" encoding="utf-8"?>
<!-- Statisztika widget: egyetlen nagy szám, ami kitölti a helyet (autoSize), felette a felirat, alatta a részlet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:paddingLeft="18dp"
    android:paddingRight="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/w_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textColor="#F5B221"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Mai órák" />

    <TextView
        android:id="@+id/w_val"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="30dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:fontFeatureSettings="tnum"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:letterSpacing="-0.02"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="20sp"
        android:autoSizeMaxTextSize="46sp"
        android:autoSizeStepGranularity="1sp"
        android:text="3" />

    <TextView
        android:id="@+id/w_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textColor="#B4B8C0"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Következő 12:00 · Menedzsment" />
</LinearLayout>
